# Copy this file to .env and fill in your values.
# Existing environment variables are not overwritten.
# Never commit .env or share these values.

# Required to talk to the Vapi API (private key from the Vapi Dashboard).
VAPI_API_KEY=

# Vapi phone number ID to place outbound calls from (imported, outbound-capable number).
VAPI_PHONE_NUMBER_ID=

# Saved assistant ID. You can instead pass --assistant-file or an inline assistant.
VAPI_ASSISTANT_ID=

# Optional. Public API key, needed only if the assistant requires authenticated live-call control.
# VAPI_PUBLIC_API_KEY=
